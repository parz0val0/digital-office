{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-office.local/status.schema.json",
  "title": "Digital Office status.json",
  "description": "数字办公室状态文件。前端每约 10 秒轮询一次。",
  "type": "object",
  "required": ["updatedAt", "plan", "agents", "collaborations"],
  "properties": {
    "updatedAt": { "type": "string", "format": "date-time", "description": "最后一次写入时间（ISO 8601，建议带时区）" },
    "meta": {
      "type": "object",
      "properties": { "mock": { "type": "boolean" }, "note": { "type": "string" } },
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "required": ["date", "items"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/planItem" } }
      }
    },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } },
    "collaborations": { "type": "array", "items": { "$ref": "#/$defs/collaboration" } }
  },
  "$defs": {
    "status": { "enum": ["working", "thinking", "collaborating", "waiting", "done", "error", "offline"] },
    "planItem": {
      "type": "object",
      "required": ["id", "title", "owner", "status", "progress"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "owner": { "type": "string", "description": "agents[].id" },
        "status": { "enum": ["todo", "doing", "done", "blocked"] },
        "progress": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "agent": {
      "type": "object",
      "required": ["id", "name", "role", "color", "desk", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "desk": { "type": "integer", "minimum": 0, "description": "工位编号，0-10 为内置工位" },
        "status": { "$ref": "#/$defs/status" },
        "currentTask": { "type": "string" },
        "progress": { "type": "number", "minimum": 0, "maximum": 100 },
        "collaboratingWith": { "type": "array", "items": { "type": "string" } },
        "log": {
          "type": "array",
          "description": "最新的在前；前端只展示最近 20 条",
          "items": {
            "type": "object",
            "required": ["time", "text"],
            "properties": { "time": { "type": "string" }, "text": { "type": "string" } }
          }
        }
      }
    },
    "collaboration": {
      "type": "object",
      "required": ["from", "to", "topic", "since"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "topic": { "type": "string" },
        "since": { "type": "string", "format": "date-time" }
      }
    }
  }
}
