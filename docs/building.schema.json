{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digital Office building.json",
  "description": "大楼总览汇总（极小）。仅在打开『大楼总览』时读取；由 scripts/update-status.mjs 自动同步。",
  "type": "object",
  "required": [
    "updatedAt",
    "floors"
  ],
  "properties": {
    "updatedAt": {
      "type": "string"
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "completion",
          "agents"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "completion": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "agents": {
            "type": "integer",
            "minimum": 0
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "各 status 的人数"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}