{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digital Office building.json",
  "description": "整栋楼视图的汇总（极小）。整栋楼视图只读这个文件；由 scripts/update-status.mjs 自动同步。",
  "type": "object",
  "required": [
    "updatedAt",
    "floors"
  ],
  "properties": {
    "updatedAt": {
      "type": "string"
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "completion",
          "agents"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "completion": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "agents": {
            "type": "integer",
            "minimum": 0
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "各 status 的人数"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "type": "object",
            "properties": {
              "done": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "members": {
            "type": "array",
            "description": "小人 + 状态色圆点所需的最小信息",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "working",
                    "thinking",
                    "collaborating",
                    "waiting",
                    "done",
                    "error",
                    "offline"
                  ]
                },
                "desk": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "roamers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "floor"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "floor": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "mock": {
          "type": "boolean"
        }
      }
    }
  }
}